# SDX RunPod defaults — source this or copy to /workspace/.sdx_env
export SDX_ROOT="${SDX_ROOT:-/workspace/sdx}"
export SDX_SECRETS_FILE="${SDX_SECRETS_FILE:-/workspace/secret.txt}"
export SDX_PRETRAINED="${SDX_PRETRAINED:-/workspace/pretrained}"
export SDX_DATA="${SDX_DATA:-/workspace/data}"
export SDX_RESULTS="${SDX_RESULTS:-/workspace/results}"
export SDX_ARTIST_INDEX="${SDX_ARTIST_INDEX:-/workspace/data/artist_index.json}"
export SDX_RAG_CORPUS="${SDX_RAG_CORPUS:-/workspace/data/rag_corpus.jsonl}"
export SDX_CONTROL_MANIFEST="${SDX_CONTROL_MANIFEST:-/workspace/data/control/manifest.jsonl}"
export SDX_ENRICHED_MANIFEST="${SDX_ENRICHED_MANIFEST:-/workspace/data/enriched/manifest.jsonl}"
export SDX_ENRICH_VLM="${SDX_ENRICH_VLM:-0}"
export SDX_ENRICH_REVERSE="${SDX_ENRICH_REVERSE:-0}"
export SDX_PROMPT_RESEARCH="${SDX_PROMPT_RESEARCH:-1}"
export SDX_ENRICH_WORKERS="${SDX_ENRICH_WORKERS:-1}"
export SDX_SKIP_PREPROCESS="${SDX_SKIP_PREPROCESS:-0}"
export SDX_TRAIN_MODE="${SDX_TRAIN_MODE:-full}"
export SDX_FULL_TRAIN_FEATURES="${SDX_FULL_TRAIN_FEATURES:-1}"
export SDX_NPROC_PER_NODE="${SDX_NPROC_PER_NODE:-1}"
export SDX_GLOBAL_BATCH_SIZE="${SDX_GLOBAL_BATCH_SIZE:-24}"
export SDX_NUM_WORKERS="${SDX_NUM_WORKERS:-32}"
export SDX_PREFETCH_FACTOR="${SDX_PREFETCH_FACTOR:-8}"
export SDX_USE_GRAD_CHECKPOINT="${SDX_USE_GRAD_CHECKPOINT:-1}"
export SDX_COMPILE_MODE="${SDX_COMPILE_MODE:-max-autotune}"
# Multi-encoder text (triple = T5 + CLIP-L + bigG; needs CLIPs in SDX_PRETRAINED)
export SDX_TEXT_ENCODER_MODE="${SDX_TEXT_ENCODER_MODE:-triple}"
export SDX_TEXT_ENCODER="${SDX_TEXT_ENCODER:-/workspace/pretrained/T5-XXL-safetensors}"
export SDX_CLIP_TEXT_ENCODER_L="${SDX_CLIP_TEXT_ENCODER_L:-/workspace/pretrained/CLIP-ViT-L-14}"
export SDX_CLIP_TEXT_ENCODER_BIGG="${SDX_CLIP_TEXT_ENCODER_BIGG:-/workspace/pretrained/CLIP-ViT-bigG-14}"
# REPA (frozen DINOv2 ViT alignment loss during DiT training)
export SDX_REPA_WEIGHT="${SDX_REPA_WEIGHT:-0.5}"
export SDX_REPA_ENCODER="${SDX_REPA_ENCODER:-facebook/dinov2-base}"
export SDX_REPA_OUT_DIM="${SDX_REPA_OUT_DIM:-768}"
# DiT architecture extras (change checkpoint shape — fresh train or --init-from only)
export SDX_SSM_EVERY_N="${SDX_SSM_EVERY_N:-4}"
export SDX_NUM_REGISTER_TOKENS="${SDX_NUM_REGISTER_TOKENS:-4}"
export SDX_LAYERSCALE_INIT="${SDX_LAYERSCALE_INIT:-1e-5}"
export SDX_CREATIVITY_EMBED_DIM="${SDX_CREATIVITY_EMBED_DIM:-64}"
export SDX_ENABLE_CONTROL_TRAIN="${SDX_ENABLE_CONTROL_TRAIN:-1}"
export SDX_MOE_NUM_EXPERTS="${SDX_MOE_NUM_EXPERTS:-0}"
# Prompt guidance parity (train via train_features.sh; sample via sample.sh)
export SDX_TRAIN_SHORTCOMINGS_2D="${SDX_TRAIN_SHORTCOMINGS_2D:-1}"
export SDX_SHORTCOMINGS_MITIGATION="${SDX_SHORTCOMINGS_MITIGATION:-auto}"
export SDX_ART_GUIDANCE_MODE="${SDX_ART_GUIDANCE_MODE:-auto}"
export SDX_ANATOMY_GUIDANCE="${SDX_ANATOMY_GUIDANCE:-auto}"
export SDX_STYLE_GUIDANCE_MODE="${SDX_STYLE_GUIDANCE_MODE:-auto}"
export SDX_SHORTCOMINGS_2D="${SDX_SHORTCOMINGS_2D:-1}"
# Ultimate pipeline: WD tagger + modular LoRA bank
export SDX_USE_WD_TAGGER="${SDX_USE_WD_TAGGER:-1}"
export SDX_WD_TAG_THRESHOLD="${SDX_WD_TAG_THRESHOLD:-0.35}"
export SDX_TAGGED_MANIFEST="${SDX_TAGGED_MANIFEST:-/workspace/data/tagged/manifest.jsonl}"
export SDX_TRAIN_LORA_BANK="${SDX_TRAIN_LORA_BANK:-1}"
export SDX_LORA_BANK="${SDX_LORA_BANK:-/workspace/data/lora_bank}"
export SDX_LORA_BANK_INDEX="${SDX_LORA_BANK_INDEX:-/workspace/data/lora_bank/index.json}"
export SDX_LORA_SUBSETS="${SDX_LORA_SUBSETS:-/workspace/data/lora_subsets}"
export SDX_LORA_MIN_SAMPLES="${SDX_LORA_MIN_SAMPLES:-150}"
export SDX_LORA_BANK_MAX_ARTISTS="${SDX_LORA_BANK_MAX_ARTISTS:-48}"
export SDX_LORA_MIN_STYLE_SAMPLES="${SDX_LORA_MIN_STYLE_SAMPLES:-200}"
export SDX_LORA_EPOCHS="${SDX_LORA_EPOCHS:-4}"
export SDX_LORA_MAX_STEPS="${SDX_LORA_MAX_STEPS:-800}"
export SDX_LATENT_CACHE="${SDX_LATENT_CACHE:-/workspace/data/latent_cache}"
export PYTORCH_CUDA_ALLOC_CONF="${PYTORCH_CUDA_ALLOC_CONF:-expandable_segments:True}"
export SDX_MAX_POSTS="${SDX_MAX_POSTS:-0}"
# hf = bulk Hugging Face datasets (fast). booru = live API scrape (slow).
export SDX_DATA_SOURCE="${SDX_DATA_SOURCE:-hf}"
export SDX_DATA_SITES="${SDX_DATA_SITES:-danbooru rule34xxx e621 rule34xyz}"
export SDX_SCRAPE_SITES="${SDX_SCRAPE_SITES:-$SDX_DATA_SITES}"
export SDX_HF_MAX_SAMPLES="${SDX_HF_MAX_SAMPLES:-$SDX_MAX_POSTS}"
export SDX_HF_IMAGE_FORMAT="${SDX_HF_IMAGE_FORMAT:-jpg}"
export SDX_API_RATE_DANBOORU="${SDX_API_RATE_DANBOORU:-9.5}"
export SDX_API_RATE_RULE34XXX="${SDX_API_RATE_RULE34XXX:-9.5}"
export SDX_API_RATE_E621="${SDX_API_RATE_E621:-1.5}"
export SDX_API_RATE_RULE34XYZ="${SDX_API_RATE_RULE34XYZ:-2.0}"
export SDX_SCRAPE_WORKERS="${SDX_SCRAPE_WORKERS:-256}"
export SDX_SCRAPE_TURBO="${SDX_SCRAPE_TURBO:-1}"
export SDX_DL_CHUNK_BYTES="${SDX_DL_CHUNK_BYTES:-1048576}"
export SDX_MANIFEST_FLUSH_EVERY="${SDX_MANIFEST_FLUSH_EVERY:-128}"
# API rate limits are per-site (above). Download workers hit CDNs in parallel.
export SDX_SPLIT_FRAMES="${SDX_SPLIT_FRAMES:-0}"
export SDX_FRAME_FPS="${SDX_FRAME_FPS:-1}"
export SDX_MAX_FRAMES_PER_POST="${SDX_MAX_FRAMES_PER_POST:-48}"
export SDX_KEEP_RAW_MEDIA="${SDX_KEEP_RAW_MEDIA:-0}"
export SDX_DL_WORKERS="${SDX_DL_WORKERS:-4}"
export HF_HOME="${HF_HOME:-/workspace/.cache/huggingface}"
export HF_HUB_ENABLE_HF_TRANSFER="${HF_HUB_ENABLE_HF_TRANSFER:-1}"
export HF_XET_HIGH_PERFORMANCE="${HF_XET_HIGH_PERFORMANCE:-1}"
export SDX_MODEL_PROFILE="${SDX_MODEL_PROFILE:-ultimate}"
