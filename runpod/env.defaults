# SDX RunPod defaults — source this or copy to /workspace/.sdx_env
export SDX_ROOT="${SDX_ROOT:-/workspace/sdx}"
export SDX_SECRETS_FILE="${SDX_SECRETS_FILE:-/workspace/secret.txt}"
export SDX_PRETRAINED="${SDX_PRETRAINED:-/workspace/pretrained}"
export SDX_DATA="${SDX_DATA:-/workspace/data}"
export SDX_RESULTS="${SDX_RESULTS:-/workspace/results}"
export SDX_ARTIST_INDEX="${SDX_ARTIST_INDEX:-/workspace/data/artist_index.json}"
export SDX_RAG_CORPUS="${SDX_RAG_CORPUS:-/workspace/data/rag_corpus.jsonl}"
export SDX_CONTROL_MANIFEST="${SDX_CONTROL_MANIFEST:-/workspace/data/control/manifest.jsonl}"
export SDX_ENRICHED_MANIFEST="${SDX_ENRICHED_MANIFEST:-/workspace/data/enriched/manifest.jsonl}"
export SDX_ENRICH_VLM="${SDX_ENRICH_VLM:-0}"
export SDX_ENRICH_REVERSE="${SDX_ENRICH_REVERSE:-0}"
export SDX_PROMPT_RESEARCH="${SDX_PROMPT_RESEARCH:-1}"
export SDX_ENRICH_WORKERS="${SDX_ENRICH_WORKERS:-1}"
export SDX_SKIP_PREPROCESS="${SDX_SKIP_PREPROCESS:-0}"
export SDX_TRAIN_MODE="${SDX_TRAIN_MODE:-full}"
export SDX_GLOBAL_BATCH_SIZE="${SDX_GLOBAL_BATCH_SIZE:-4}"
export HF_HOME="${HF_HOME:-/workspace/.cache/huggingface}"
export HF_HUB_ENABLE_HF_TRANSFER="${HF_HUB_ENABLE_HF_TRANSFER:-1}"
